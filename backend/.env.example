# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=node_mysql_api

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string

# ─── Email (Ethereal for dev / real SMTP for prod) ───────────────────────────
EMAIL_FROM=info@your-app.com
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user@ethereal.email
SMTP_PASS=your_ethereal_password

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set this to the deployed Angular frontend URL in production
CORS_ORIGIN=http://localhost:4200

# ─── Cookies ──────────────────────────────────────────────────────────────────
# Set to true in production so cookies are only sent over HTTPS
COOKIE_SECURE=false

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
